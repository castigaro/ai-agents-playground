# Local-only overrides for n8n helper scripts.
# Copy this file to .env.local and adjust the path if needed.
#
# This file is never committed. It is meant for private working copies and
# machine-specific API access during local testing.

N8N_PRIVATE_DATA_DIR=.local/n8n-data
# Optional: only needed if you do not want to export the API key in the shell session.
# N8N_API_KEY=your-local-api-key
