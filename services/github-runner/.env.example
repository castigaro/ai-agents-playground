# Registration token for the first start (valid for one hour); the
# registration is kept in a volume afterwards. Settings > Actions > Runners
# > New self-hosted runner shows it, or:
# gh api -X POST repos/castigaro/spacesonar-pro/actions/runners/registration-token --jq .token
RUNNER_TOKEN=

# Alternative: a personal access token with repository administration; the
# container then fetches registration tokens itself (long-lived secret).
#ACCESS_TOKEN=

# Repository and runner identity; GitHub adds self-hosted, Linux and X64 to the labels.
REPO_URL=https://github.com/castigaro/spacesonar-pro
RUNNER_NAME=homeserver
LABELS=spacesonar

# Parallel rustc jobs; lower it to keep the other containers responsive.
CARGO_BUILD_JOBS=4

TZ=Europe/Berlin
