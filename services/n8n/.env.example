# Public endpoint and certificate contact
N8N_DOMAIN=n8n.example.tld
SSL_EMAIL=admin@example.tld

# Runtime defaults for n8n
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.tld/
WEBHOOK_URL=https://n8n.example.tld/
N8N_SECURE_COOKIE=true
N8N_RUNNERS_ENABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_PROXY_HOPS=1

# Timezone settings
TZ=Europe/Berlin
GENERIC_TIMEZONE=Europe/Berlin
