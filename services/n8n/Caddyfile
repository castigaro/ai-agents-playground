# Globale Einstellungen (Deine E-Mail bleibt erhalten)
{
  email {$SSL_EMAIL}
}

# BLOCK 1: Dein lokaler Zugriff auf n8n (Dashboard & Editor)
# Läuft auf Port 443. In der Firewall NICHT nach außen freigeben!
{$N8N_DOMAIN} {
  encode zstd gzip
  reverse_proxy n8n:5678
}

# BLOCK 2: Externer Telegram-Zugriff (Nur Webhooks)
# Läuft auf Port 8443. Diesen Port gibst du in deiner Firewall frei!
{$N8N_DOMAIN}:8443 {
  encode zstd gzip

  # Erlaube AUSSCHLIESSLICH die n8n Webhook-Pfade
  @webhooks path /webhook/* /webhook-test/*
  handle @webhooks {
    reverse_proxy n8n:5678
  }

  # Blockiere jede andere Anfrage auf Port 8443 (z.B. Dashboard-Aufrufe)
  handle {
    abort
  }
}